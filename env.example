# These three go in the Vercel dashboard, NOT in a file you commit.
# This file is only a reference for what the names should be.
#
# Copy to .env.local if you want to run `vercel dev` locally.
# .env.local is gitignored; never commit real values.

# Supabase -> Project Settings -> Data API -> Project URL
SUPABASE_URL=https://abcdefghijklm.supabase.co

# Supabase -> Project Settings -> API Keys -> service_role (click "Reveal")
# This key bypasses row level security. Server-side only.
# Never prefix it with VITE_ or NEXT_PUBLIC_ - that would ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Any random string. Vercel sends it as `Authorization: Bearer <value>` when it
# fires the cron, and the handler rejects requests without it.
# Generate one in PowerShell (openssl is not installed on this machine):
#   $b = [byte[]]::new(32)
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   -join ($b | ForEach-Object { $_.ToString('x2') })
CRON_SECRET=replace-me
